{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "video_construct_scores",
  "title": "Video Construct Scores Artifact",
  "type": "object",
  "required": ["artifact", "student_id", "cohort_year", "rubric_id", "schema_version", "generated_at", "session_scores", "step_level_inferences"],
  "properties": {
    "$schema": {"type": "string"},
    "artifact": {"const": "construct_scores"},
    "student_id": {"type": "string", "minLength": 1},
    "cohort_year": {"type": "integer"},
    "rubric_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "session_scores": {
      "type": "object",
      "patternProperties": {
        "^B([0-9]|1[0-3])$": {
          "type": "object",
          "required": ["level", "confidence"],
          "properties": {
            "level": {"type": "string"},
            "confidence": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "session_notes": {"type": ["string", "null"]},
    "key_evidence": {"type": "object"},
    "audio_available": {"type": ["boolean", "null"]},
    "step_level_inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_index", "behavior_codes"],
        "properties": {
          "step_index": {"type": ["integer", "null"]},
          "behavior_codes": {"type": "array", "items": {"type": "string"}},
          "behavior_details": {"type": "array", "items": {"type": "object"}},
          "construct_levels_hint": {"type": "object"},
          "certainty": {"type": ["string", "null"]},
          "silver_confidence": {"type": ["string", "null"]},
          "silver_frame_id": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "alignment_quality": {"type": "object"},
    "interpretation_rule": {"type": "string"}
  },
  "additionalProperties": true
}
