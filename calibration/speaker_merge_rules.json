{
  "version": "2",
  "method": "merged_transcript_hybrid_diarization_v2",
  "diarization_pick": {
    "max_gap_seconds": 18.0,
    "interpolate_max_gap_seconds": 35.0
  },
  "review": {
    "confidence_threshold": 0.5,
    "flag_unknown": true,
    "flag_role_flips": true
  },
